{
  "name": "swcode",
  "version": "0.5.0",
  "private": true,
  "description": "A coding agent for local models on llm-server: a daemon that runs the agent and its tools, and a web app to follow and steer it from a computer or a phone",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "build:binary": "npm run build && node scripts/build-binary.mjs",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "install:desktop": "node scripts/install-desktop.mjs",
    "install:binary": "npm run build:binary && node scripts/install-binary.mjs",
    "start": "SWCODE_ENV=production go run ./cmd/swcode serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "e2e:install": "playwright-core install chromium-headless-shell",
    "typecheck": "tsc --noEmit -p web && tsc --noEmit -p e2e",
    "protocol": "tsx scripts/protocol-go.ts",
    "check:go": "tsx scripts/protocol-go.ts --check && $(go env GOROOT)/bin/gofmt -l . | (! grep .) && go vet ./... && GOOS=windows go vet -unsafeptr=false ./... && go test -race ./...",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:go"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@jadis/core": "^1.8.0",
    "@syware/jlib": "^0.12.0",
    "@types/node": "^24.13.3",
    "lucide": "^1.61.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
