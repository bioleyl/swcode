{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "source": [":URL:", ":NODE:"],
                "type": false
              },
              ":BLANK_LINE:",
              {
                "source": [":PACKAGE:"],
                "type": false
              },
              ":BLANK_LINE:",
              {
                "source": [":ALIAS:", ":PATH:"],
                "type": false
              },
              ":BLANK_LINE:",
              {
                "source": [":URL:", ":NODE:", ":PACKAGE:", ":ALIAS:", ":PATH:"],
                "type": true
              }
            ]
          }
        },
        "useSortedKeys": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "*.json",
      "*.ts",
      "scripts/**/*.mjs",
      "shared/**/*.ts",
      "e2e/**/*.ts",
      "web/**/*.{ts,tsx,css}",
      "!**/node_modules",
      "!dist",
      "!data",
      // Claude Code's worktrees: other checkouts, each with its own configuration.
      "!!.claude"
    ]
  },
  "formatter": {
    "attributePosition": "auto",
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 115,
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "auto",
      "bracketSameLine": true,
      "bracketSpacing": true,
      "expand": "auto",
      "indentStyle": "space",
      "operatorLinebreak": "before",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "formatter": {
      "bracketSpacing": true,
      "expand": "auto",
      "indentStyle": "space",
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedImports": {
          "fix": "safe",
          "level": "error",
          "options": {}
        }
      },
      "preset": "recommended",
      "style": {
        "useBlockStatements": {
          "fix": "safe",
          "level": "error",
          "options": {}
        },
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "formats": ["camelCase"],
                "match": "_(.+)",
                "selector": {
                  "kind": "classProperty",
                  "modifiers": ["private"]
                }
              }
            ],
            "requireAscii": true,
            "strictCase": false
          }
        }
      }
    }
  },
  "overrides": [
    // Jadis renders a template once and fills in text and links through refs afterwards, so an empty
    // heading or an anchor without href in a template is filled in before anyone sees it.
    {
      "includes": ["web/src/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useHeadingContent": "off",
            "useValidAnchor": "off"
          }
        }
      }
    },
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      },
      "includes": ["**/*.json"]
    }
  ]
}
