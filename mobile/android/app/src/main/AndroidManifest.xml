<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Keeps the app's socket alive while the phone sleeps, with its notice in the shade. -->
        <service
            android:name=".NotifierService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The app installs its next release itself, from swcode's GitHub releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Capacitor asks for this when a page reads a QR code with the camera; without it declared, Android denies
         the ask at once, and the scanner's page never gets the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Dictation in the composer: the WebView's speech recognition listens through Android's recognizer, which
         refuses an app that does not hold this. The WebView never asks for it itself (MicrophonePlugin does). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The app tells the person through Android itself (NotifierPlugin): on Android 13+ this is what Android asks. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Its service at the front of Android's list, which keeps the daemon's socket alive while the phone sleeps.
         Android 14+ refuses to bring a connectedDevice service to the front without its own permission, and throws
         SecurityException from the service when it is missing, which takes the whole app down as it opens. That
         type also needs one of its prerequisites granted: the socket's network one, which Android grants itself. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Android 11+ hides other apps' services: the WebView looks the speech recognizer up by this action. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
